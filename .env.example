# Copy to .env for local development. Never commit .env or production secrets.
APP_ENV=development
APP_NAME=ODEI Clinic OS
API_HOST=127.0.0.1
API_PORT=8000

# Use a newly rotated, least-privilege MongoDB application user.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=odei_clinic_os

# Generate independent high-entropy values locally.
SECRET_KEY=replace-with-generated-local-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Configure approved integrations per environment.
FHIR_BASE_URL=
SMS_PROVIDER=
EMAIL_PROVIDER=
OBJECT_STORAGE_ENDPOINT=
