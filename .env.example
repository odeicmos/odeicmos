# Copy to .env for local development. Never commit .env or production secrets.
ODEI_ENVIRONMENT=development
ODEI_APP_NAME=ODEI Clinic Management OS API
ODEI_API_PREFIX=/api/v1
ODEI_LOG_LEVEL=INFO

# Use a newly rotated, least-privilege MongoDB application user.
ODEI_MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
ODEI_MONGODB_DATABASE=odei_clinic

# Configure an approved OIDC issuer and its HTTPS JWKS endpoint.
ODEI_OIDC_ISSUER=
ODEI_OIDC_AUDIENCE=
ODEI_OIDC_JWKS_URL=
ODEI_OIDC_JWKS_CACHE_SECONDS=300
