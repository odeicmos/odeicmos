# Non-secret defaults only. Inject credentials from a secret manager at runtime.
ODEI_ENVIRONMENT=development
ODEI_API_PREFIX=/api/v1
ODEI_LOG_LEVEL=INFO
ODEI_MONGODB_DATABASE=odei_clinic
# Set ODEI_MONGODB_URI in a secret manager; never commit a real URI.
# OIDC resource server configuration. All three values required to enable business APIs.
ODEI_OIDC_ISSUER=
ODEI_OIDC_AUDIENCE=
ODEI_OIDC_JWKS_URL=
# RS256 only by default; configure only algorithms approved by your identity provider.
